@model MvcSample.Models.ViewModels.LoginRegisterViewModel

@{
    ViewData["Title"] = "Login / Register";
}

<style>
    body {
      background-color: #36454F;
    } 

    .auth-wrapper {
        min-height: calc(100vh - 120px);
        display:flex;
        justify-content:center;
        align-items:center;
        background:linear-gradient(135deg, #111,222);
    }

    .auth-card {
        width:420px;
        background:white;
        border-radius:25px;
        padding:35px;
        box-shadow: 0 25px 60px rgba(0,0,0,.35);
        animation: cardEnter .7s ease forwards;
        overflow:hidden;
        transition: height .5s ease;
    }

    @@keyframes cardEnter {
        from {
            opacity:0;
            transform: translateY(-40px) scale(.9);
        }
        to {
            opacity:1;
            transform:translateY(0) scale(1);
        }
    }

    .auth-tabs {
        display:flex;
        background:#eee;
        border-radius:50px;
        padding:5px;
        margin-bottom:30px;
    }

    .auth-tabs button {
        flex:1;
        border:none;
        background:transparent;
        padding:6px;
        border-radius:30px;
        font-weight:600;
        cursor:pointer;
        transition:.3s;
    }

    .auth-tabs button.active {
        background:#198754;
        color:white;
        box-shadow: 0 5px 15px rgba(25,135,84,.4);
    }

    .form-container {
        position:relative;
    }

    .auth-form {
        display:none;
        animation: fadeSlide .4s ease;
    }

    .auth-form.active {
        display:block;
    }

    .auth-form h6 {
        font-size: 14px;
    }

    input::placeholder,
    textarea::placeholder {
        font-size: 12px;
    }

    @@keyframes fadeSlide {
        from {
            opacity:0;
            transform:translateX(30px);
        }
        to {
            opacity:1;
            transform:translateX(0);
        }
    }

    .auth-card h3 {
        text-align:center;
        margin-bottom:25px;
        font-weight:700;
    }

    .form-control {
        height:42px;
        border-radius:10px;
        font-size:13px;
        padding:8px 14px;
    }

    .btn {
        height:42px;
        border-radius:10px;
        font-size:13px;
        font-weight:600;
    }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-tabs">
            <button id="loginTab" class="btn btn-sm active"onclick="showLogin()">Login</button>
            <button id="registerTab" class="btn btn btn-sm" onclick="showRegister()">Register</button>
        </div>

        <div class="form-container">
            <div id="loginForm" class="auth-form active text-center">
                <h6>Continue Your Season</h6>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">
                    <input asp-for="LoginEmail" class="form-control mb-3" placeholder="Email" required />
                    <input asp-for="LoginPassword" class="form-control mb-3" placeholder="Password" required />
                    <button class="btn btn-sm btn-success w-100">Login</button>
                </form>
            </div>

            <div id="registerForm" class="auth-form text-center">
                <h6>Start Your Hockey Journey</h6>
                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">
                    <input asp-for="RegisterEmail" class="form-control mb-3" placeholder="Email" required />
                    <input asp-for="RegisterPassword" class="form-control mb-3" placeholder="Password" required />
                    <input asp-for="ConfirmPassword" class="form-control mb-3" placeholder="Confirm Password" required />
                    <button class="btn btn-sm btn-success w-100 p-2"> Register</button>
                </form>
            </div>

        </div>

    </div>
</div>

<script>
function showLogin(){
    document.getElementById("loginForm").classList.add("active");
    document.getElementById("registerForm").classList.remove("active");
    document.getElementById("loginTab").classList.add("active");
    document.getElementById("registerTab").classList.remove("active");
}

function showRegister(){
    document.getElementById("registerForm").classList.add("active");
    document.getElementById("loginForm").classList.remove("active");
    document.getElementById("registerTab").classList.add("active");
    document.getElementById("loginTab").classList.remove("active");
}
</script>
