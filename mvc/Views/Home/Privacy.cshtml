@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap');

    body {
        font-family: "Source Sans 3", sans-serif;
        font-size: 14px;
    }

    .privacy-frame {
        width: 75%;
        max-width: 900px;
        height: 400px;
        overflow-y: auto;
        padding: 2rem;
        background: #fff;
        color: #212529;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,.2);
        text-align: left;
    }

    .privacy-frame h4 {
        margin-top: 1.75rem;
    }

    .privacy-frame h4:first-child {
        margin-top: 0;
    }
</style>

<div class="container mt-3 mb-5 pb-5">
    <h5 class="text-center mb-4">@ViewData["Title"]</h5>

    <p class="text-muted text-center">
        Last Updated: July 31, 2026
    </p>

    <div class="privacy-frame mx-auto text-center">
                <h6>Overview</h6>
                <p>
                    Thank you for visiting our Northwoods Ice community website. This site was created to provide
                    visitors with information about the facility, its amenities, and helpful resources. While we
                    may provide links to the official Northwoods Ice website, this website is an independent
                    informational resource and is not affiliated with, endorsed by, or operated by Northwoods Ice.
                </p>

                <h6>Information We Collect</h6>
                <p>
                    We do not require visitors to create an account or provide personal information simply to browse
                    this website. If you choose to contact us through a form or email, you may voluntarily provide
                    information such as your name, email address, or message so we can respond to your inquiry.
                </p>

                <h6>Cookies and Analytics</h6>
                <p>
                    This website may use cookies or basic analytics tools to understand how visitors use the site,
                    improve performance, and enhance the user experience. These technologies collect anonymous
                    information such as browser type, pages visited, and approximate device information. They are
                    not used to personally identify visitors.
                </p>

                <h6>Third-Party Links</h6>
                <p>
                    For your convenience, this website may contain links to third-party websites, including the
                    official Northwoods Ice website. Once you leave this website, you are subject to the privacy
                    practices and policies of the destination website. We encourage you to review their privacy
                    policy before providing any personal information. [Northwoods Ice Official Website](https://northwoodsice.net/?utm_source=chatgpt.com)
                </p>

                <h6>Information Security</h6>
                <p>
                    We take reasonable measures to help protect any information voluntarily submitted through this
                    website. However, no method of transmitting or storing data over the internet is completely
                    secure, and we cannot guarantee absolute security.
                </p>

                <h6>Children's Privacy</h6>
                <p>
                    This website is intended for general audiences and is not designed to knowingly collect personal
                    information from children under the age of 13.
                </p>

                <h6>Policy Updates</h6>
                <p>
                    We may update this Privacy Policy from time to time to reflect changes to this website or
                    applicable laws. Any updates will be posted on this page with a revised effective date.
                </p>

                <h6>Contact</h6>
                <p>
                    If you have questions regarding this Privacy Policy or this website, please contact the site
                    administrator. For questions regarding Northwoods Ice facilities, programs, reservations, or
                    events, please visit the official Northwoods Ice website.
                </p>
            
        </div>
    </div>
</div>
