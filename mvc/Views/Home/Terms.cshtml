@{
    ViewData["Title"] = "Website Terms";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap');

    body {
        font-family: "Source Sans 3", sans-serif;
        font-size: 14px;
    }

    .privacy-frame {
        width: 75%;
        max-width: 900px;
        height: 400px;
        overflow-y: auto;
        padding: 2rem;
        background: #fff;
        color: #212529;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,.2);
        text-align: left;
    }

    .privacy-frame h5 {
        margin-top: 1.75rem;
    }

    .privacy-frame h5:first-child {
        margin-top: 0;
    }
</style>

<div class="container mt-3 mb-5 pb-5">
    <h5 class="text-center mb-4">@ViewData["Title"]</h5>

    <p class="text-muted text-center">
        Last Updated: July 31, 2026
    </p>

    <div class="privacy-frame mx-auto text-center">

        <h6>Acceptance of Terms</h6>
        <p>
            By accessing and using this website, you agree to comply with these Website Terms. If you
            do not agree with any portion of these terms, please discontinue use of this website.
        </p>

        <h6>Purpose of This Website</h6>
        <p>
            This website is an independent informational resource created to share general information
            about Northwoods Ice, its amenities, and local hockey activities. It is not the official
            Northwoods Ice website and is not affiliated with, endorsed by, or operated by Northwoods
            Ice or its management.
        </p>

        <h6>Website Content</h6>
        <p>
            We strive to provide accurate and up-to-date information. However, schedules, pricing,
            programs, operating hours, events, and facility information may change without notice.
            Visitors should verify important information with the official Northwoods Ice website before
            making travel plans or reservations.
        </p>

        <h6>External Links</h6>
        <p>
            This website may include links to third-party websites, including the official Northwoods
            Ice website. These links are provided solely for your convenience. We are not responsible
            for the content, availability, or privacy practices of external websites.
        </p>

        <h6>Intellectual Property</h6>
        <p>
            Unless otherwise noted, the original content, layout, and design of this website are the
            property of this website's creator. Trademarks, logos, business names, and other materials
            belonging to third parties remain the property of their respective owners.
        </p>

        <h6>Permitted Use</h6>
        <p>
            You may use this website for personal, informational, and non-commercial purposes. You
            agree not to misuse the website, attempt unauthorized access, distribute malicious software,
            or interfere with its normal operation.
        </p>

        <h6>Disclaimer</h6>
        <p>
            All information on this website is provided "as is" without warranties of any kind,
            expressed or implied. While we make every effort to keep the information current and
            accurate, we do not guarantee that all content will always be complete, accurate, or
            available.
        </p>

        <h6>Limitation of Liability</h6>
        <p>
            The website owner shall not be liable for any direct, indirect, incidental, or consequential
            damages resulting from the use of this website or reliance upon its content.
        </p>

        <h6>Changes to These Terms</h6>
        <p>
            These Website Terms may be updated periodically without prior notice. Continued use of the
            website after changes have been posted constitutes acceptance of the revised terms.
        </p>

        <h6>Contact</h6>
        <p>
            If you have questions regarding these Website Terms, please contact the website
            administrator. For official information regarding Northwoods Ice, including events,
            reservations, public skating, and hockey programs, please visit the official Northwoods Ice
            website.
        </p>

    </div>
</div>
