@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-light mr-2 mt-1"
           asp-controller="Account"
           asp-action="LoginRegister">
            Hello @User.Identity.Name!
        </a>
    </li>

    <li class="nav-item">
        <form class="form-inline"
              asp-controller="Account"
              asp-action="Logout"
              method="post">

            <button type="submit"
                    class="nav-link btn btn-link text-light mr-1 mt-1">
                Logout
            </button>

        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light mr-1 mt-1"
           asp-controller="Account"
           asp-action="LoginRegister">
            Login / Register
        </a>
    </li>

    <li class="nav-item mt-2 ms-3">

        <div class="d-flex align-items-start text-success">

            <a href="https://www.google.com/maps/search/?api=1&query=Ice+%26+Golf+Center+At+Northwoods,+17530+Henderson+Pass,+San+Antonio,+TX+78232"
               target="_blank"
               class="text-success me-2 mt-1">

                <i class="fa-solid fa-location-dot fa-lg me-1 mt-2 ml-5 mr-3"
                   style="color:#55DD33 !important;">
                </i>

            </a>

            <div style="font-size:10px;font-weight:600;line-height:1.3;">

                <div class="text-light">
                    17530 Henderson Pass
                </div>

                <div class="text-light">
                    San Antonio, TX 78232
                </div>

                <div>
                    <a href="tel:+12104909550"
                       class="text-success text-decoration-none"
                       style="color:#55DD33 !important;">

                        (210) 490-9550

                    </a>
                </div>

            </div>

        </div>

    </li>
}

</ul>
