@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Northwoods Hockey Home - San Antonio, TX</title>
    <link rel="icon" type="image/x-icon" href="https://cdn.logojoy.com/wp-content/uploads/20231124135945/hockey-logo-featured-image.png">
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
</head>

<body>

<style>
    @@media (max-width: 576px) { 
        footer {
            font-size: 12px !important; 
        }
    }

    .navbar-toggler {
        width: 36px;
        height: 36px;
        padding: 0;
        border: 2px solid rgba(255,255,255,.15);
        border-radius: 50%;
        background: #198754 !important;
        box-shadow:
            inset 0 -2px 0 rgba(0,0,0,.25),
            0 2px 4px rgba(0,0,0,.35);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .navbar-toggler:hover {
        transform: scale(1.05);
        box-shadow:
            inset 0 -2px 0 rgba(0,0,0,.25),
            0 3px 6px rgba(0,0,0,.45);
    }

    .navbar-toggler:active {
        transform: scale(.96);
    }

    .navbar-toggler:focus,
    .navbar-toggler:active {
        outline: none !important;
        box-shadow:
            inset 0 -2px 0 rgba(0,0,0,.25),
            0 0 0 0 !important;
    }

    .navbar-toggler-icon {
        width: 0.9rem;
        height: 0.9rem;
    }
</style>
    
    <header style="font-size: 14px;">
        <nav class="navbar navbar-expand-lg navbar-light bg-dark border-bottom box-shadow" style="opacity: 0.9; z-index: 1050;">
            <div class="container">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="navbar-brand text-light d-flex align-items-center"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Main"
                       style="font-size: 14px;">

                        <img src="https://images.seeklogo.com/logo-png/6/2/ice-hockey-logo-png_seeklogo-69481.png"
                             alt="Northwoods Ice Hockey Logo"
                             style="height: 32px; width: auto; margin-right: 8px;">

                        <span class="text-nowrap">Northwoods Ice Hockey</span>
                    </a>
                }
                else
                {
                    <a class="navbar-brand text-light d-flex align-items-center"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       style="font-size: 14px;">

                        <img src="https://images.seeklogo.com/logo-png/6/2/ice-hockey-logo-png_seeklogo-69481.png"
                             alt="Northwoods Ice Hockey Logo"
                             style="height: 32px; width: auto; margin-right: 8px;">

                        <span class="text-nowrap">Northwoods Ice Hockey</span>
                    </a>
                }

                <button class="navbar-toggler bg-success py-0 px-1 border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a class="nav-link text-success"
                                   asp-controller="Home"
                                   asp-action="Main"
                                   style="color:#55DD33 !important;">
                                    Home
                                </a>
                            }
                            else
                            {
                                <a class="nav-link text-success"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   style="color:#55DD33 !important;">
                                    Home
                                </a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Games">
                                Gameday
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Teams">
                                Teams
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Scores">
                                Scores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Stats">
                                Statistics
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Leagues</a>
                            <ul class="dropdown-menu bg-dark text-light" style=>
                              <li><a class="dropdown-item bg-dark text-light" href="#">AHL (A Div)</a></li>
                              <li><a class="dropdown-item bg-dark text-light" href="#">ARL (B Div)</a></li>
                              <li><a class="dropdown-item bg-dark text-light" href="#">BHL (C Div)</a></li>
                              <li><a class="dropdown-item bg-dark text-light" href="#">RRHL (D Div)</a></li>
                            </ul>
                          </li>
                    </ul>

                     <div class="ms-lg-auto">
                         <partial name="_LoginPartial" />
                     </div>
                </div>

            </div>
        </nav>
    </header>
    
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div> 

    <footer class="border-top footer bg-dark text-light pt-1 mt-0" style="font-size: 14px; opacity: 0.9;">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 Northwoods Ice Hockey
            </div>

            <div>
                <a class="text-primary text-decoration-none px-1" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a class="text-primary text-decoration-none px-1" asp-area="" asp-controller="Home" asp-action="Terms">Terms</a>
                <a class="text-primary text-decoration-none px-1" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                <a class="text-primary text-decoration-none px-1" asp-area="" asp-controller="Home" asp-action="About">About</a>
            </div>
        </div>
    </footer>

     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
