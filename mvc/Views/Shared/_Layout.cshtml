<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - mvc</title>
  
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
</head>

<body>
        <header style="font-size: 14px;">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark border-bottom box-shadow" style="opacity: 0.9; z-index: 1050;">
            <div class="container">
                <a class="navbar-brand text-light" asp-area="" asp-controller="Home" asp-action="Index" style="font-size: 14px;">
                    Northwoods Hockey Hub
                </a>

                <div class="collapse navbar-collapse justify-content-center">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-success" asp-area="" asp-controller="Home" asp-action="Index" style="color: #55DD33 !important;">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">
                                Gameday
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">
                                Teams
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">
                                Scores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">
                                Statistics
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Leagues</a>
                            <ul class="dropdown-menu bg-dark text-light" style=>
                              <li><a class="dropdown-item bg-dark text-light" href="#">AHL (A Div)</a></li>
                              <li><a class="dropdown-item bg-dark text-light" href="#">ARL (B Div)</a></li>
                              <li><a class="dropdown-item bg-dark text-light" href="#">BHL (C Div)</a></li>
                              <li><a class="dropdown-item bg-dark text-light" href="#">RRHL (D Div)</a></li>
                            </ul>
                          </li>
                    </ul>
                </div>

                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div> 

    <footer class="border-top footer bg-dark text-light pt-1 mt-0" style="font-size: 14px; opacity: 0.9;">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 Northwoods Hockey Hub
            </div>

            <div>
                <a class="text-primary text-decoration-none mr-2" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a class="text-primary text-decoration-none ms-3 mr-2" asp-area="" asp-controller="Home" asp-action="Terms">Terms</a>
                <a class="text-primary text-decoration-none ms-3 mr-2" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                <a class="text-primary text-decoration-none ms-3" asp-area="" asp-controller="Home" asp-action="About">About</a>
            </div>
        </div>
    </footer>

     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
